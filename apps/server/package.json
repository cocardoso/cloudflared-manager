    "@fastify/rate-limit": "^10.0.0",
    "zod": "^4.3.0"
  },
  "devDependencies": { "@types/node": "^24.0.0", "esbuild": "^0.28.0", "tsx": "^4.20.0", "vitest": "^4.1.0", "typescript": "^5.9.0" }
